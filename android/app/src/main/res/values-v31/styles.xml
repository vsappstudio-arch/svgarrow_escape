<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (API 31+) shows its own system splash screen before
         the activity's window (and therefore launch_background.xml)
         ever appears. Left uncustomized, that system phase defaults to
         a white/light background, which is the white flash this
         overrides: a black background with no icon, so it's visually
         indistinguishable from the black + VS App Studio artwork that
         launch_background.xml shows immediately afterwards. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/black</item>
    </style>
    <!-- Parented to Theme.Black rather than Theme.Light: ARROWW's Flutter UI
         is unconditionally dark, so the host window shouldn't fall back to
         a light theme just because the device's system theme is light -
         see values/styles.xml's NormalTheme for the full rationale. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
